# Solo desarrollo local. Usa una contraseña alfanumérica antes del primer arranque.
# No reutilices contraseñas de otros servicios ni subas .env al repositorio.
POSTGRES_PASSWORD=mini_fury_local_change_me

# Desarrollo local HTTP solamente. En HTTPS usa COOKIE_SECURE=true.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DB_MAX_CONNECTIONS=10
