# Copy to .local/production.env and set real values. This does not activate public hosting.
POSTGRES_PASSWORD=replace_with_a_unique_alphanumeric_password
SITE_ADDRESS=mini-fury.example.com
PUBLIC_ORIGIN=https://mini-fury.example.com
# Explicit opt-in when DNS and firewall are ready:
BIND_IP=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443

# Use independent service secrets in production; create these private files first.
METRICS_TOKEN_FILE=.local/production-metrics_token
GRAFANA_PASSWORD_FILE=.local/production-grafana_password
# GRAFANA_PUBLIC_URL=https://grafana.example.com/d/mini-fury-operations
