# Copy to .local/production-runtime.env. Generate a new independent DELIVERY_KEY.
# DELIVERY_KEY=<32 random bytes encoded in base64>
# SMTP_ADDRESS=smtp.example.com:587
# SMTP_FROM=mini-fury@example.com
# SMTP_USER=<provider username>
# SMTP_PASSWORD=<provider secret>
SMTP_ALLOW_LOCAL=false
WEBHOOK_ALLOW_LOCAL=false
# ALERT_WEBHOOK_URL=https://<authorized endpoint>
# ALERT_WEBHOOK_SECRET=<shared signing secret if supported>
# LOKI_URL=http://loki:3100
# PROMETHEUS_URL=http://prometheus:9090
# GRAFANA_PUBLIC_URL=https://grafana.example.com/d/mini-fury-operations
# METRICS_TOKEN=<independent service token>
