# Copy to .local/backup.env only when an authorized external destination exists.
# Every value below must be replaced. Never commit the populated file.
RESTIC_REPOSITORY=s3:https://s3.example.com/your-bucket/mini-fury
RESTIC_PASSWORD=replace_with_an_independent_long_random_encryption_password
AWS_ACCESS_KEY_ID=replace_with_a_bucket_scoped_access_key
AWS_SECRET_ACCESS_KEY=replace_with_the_provider_secret
AWS_DEFAULT_REGION=us-east-1
BACKUP_INTERVAL_SECONDS=86400
# For local verification only, setup-operations.py uses RESTIC_REPOSITORY=/repository.
