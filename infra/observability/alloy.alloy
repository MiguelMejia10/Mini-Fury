local.file_match "platform" {
 path_targets = [{"__path__" = "/logs/*.log", "app" = "mini-fury"}]
 sync_period = "5s"
}
loki.source.file "platform" {
 targets = local.file_match.platform.targets
 forward_to = [loki.write.local.receiver]
}
loki.write "local" {
 endpoint { url = "http://loki:3100/loki/api/v1/push" }
}
