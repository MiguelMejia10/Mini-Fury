{
  "uid": "mini-fury-operations",
  "title": "Mini Fury / Operaci\u00f3n hist\u00f3rica",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Solicitudes por segundo",
      "datasource": {
        "type": "prometheus",
        "uid": "mini-fury-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mini_fury_http_requests_total[2m]))",
          "legendFormat": "Solicitudes por segundo"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errores por segundo",
      "datasource": {
        "type": "prometheus",
        "uid": "mini-fury-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mini_fury_http_errors_total[2m]))",
          "legendFormat": "Errores por segundo"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latencia p95 estimada",
      "datasource": {
        "type": "prometheus",
        "uid": "mini-fury-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(mini_fury_http_request_duration_seconds_bucket[2m])))",
          "legendFormat": "Latencia p95 estimada"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Logs operativos de Mini Fury (sin cuerpos ni credenciales)",
      "datasource": {
        "type": "loki",
        "uid": "mini-fury-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"mini-fury\"}",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 14
      }
    }
  ]
}